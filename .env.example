# ============================================
# XsusLauncher - Konfiguracja środowiska
# ============================================
# OPCJONALNE: Skopiuj do .env i uzupełnij wartości
#   cp .env.example .env && nano .env
#
# Bez pliku .env system działa z domyślnymi ustawieniami:
#   - JWT_SECRET: auto-generowany i zapisywany do data/.jwt_secret
#   - ADMIN: admin/admin (zmień w panelu po pierwszym logowaniu)
#   - MC_SERVER_IP: localhost
# ============================================

# Serwer
NODE_ENV=production
PORT=3001

# Bezpieczeństwo
# Zostaw puste = auto-generowanie (zalecane dla prostoty)
# Lub wygeneruj ręcznie: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Konto administratora (używane TYLKO przy pierwszym uruchomieniu)
# Po utworzeniu konta, hasło można zmienić w panelu admina
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Serwer Minecraft (domyślny - dodatkowe serwery dodaj w panelu)
MC_SERVER_IP=xsus.pl
MC_SERVER_PORT=25568

# Limity
MAX_FILE_SIZE_MB=100

# CurseForge API (opcjonalne - do pobierania modów z CurseForge)
# Klucz z: https://console.curseforge.com/
CURSEFORGE_API_KEY=

# URLs (opcjonalne - dla CORS w produkcji)
# ADMIN_URL=https://mc.xsus.pl
# API_URL=https://mc.xsus.pl/api

# Discord webhook (opcjonalne - powiadomienia)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
