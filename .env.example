# ============================================
# XsusLauncher - Konfiguracja środowiska
# Skopiuj do .env i uzupełnij wartości
# ============================================

# Serwer
NODE_ENV=production
PORT=3001

# Bezpieczeństwo - ZMIEŃ NA WŁASNE WARTOŚCI!
# Wygeneruj: openssl rand -hex 64
JWT_SECRET=ZMIEN_NA_BEZPIECZNY_KLUCZ_64_ZNAKOW
JWT_EXPIRES_IN=7d

# Konto administratora
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ZMIEN_HASLO_ADMINA

# Serwer Minecraft
MC_SERVER_IP=play.twojserwer.pl
MC_SERVER_PORT=25565

# Limity
MAX_FILE_SIZE_MB=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# URLs (opcjonalne - dla CORS w produkcji)
# ADMIN_URL=https://mc.xsus.pl
# API_URL=https://mc.xsus.pl/api
