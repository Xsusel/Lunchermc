# ============================================
# KONFIGURACJA SERWERA
# ============================================
PORT=3001
NODE_ENV=production
API_URL=http://localhost:3001

# ============================================
# BEZPIECZENSTWO
# ============================================
# Wygeneruj bezpieczny klucz: openssl rand -hex 64
# WYMAGANE: Minimum 32 znaki
JWT_SECRET=ZMIEN_NA_BEZPIECZNY_KLUCZ_MIN_32_ZNAKOW
JWT_EXPIRES_IN=7d

# Haslo do panelu administracyjnego (minimum 6 znakow)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ZMIEN_HASLO_ADMINA

# ============================================
# BAZA DANYCH
# ============================================
DATABASE_PATH=./data/launcher.db

# ============================================
# SERWER MINECRAFT
# ============================================
MC_SERVER_IP=play.twojserwer.pl
MC_SERVER_PORT=25565

# ============================================
# LIMITY
# ============================================
MAX_FILE_SIZE_MB=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# BACKUPY
# ============================================
BACKUP_INTERVAL_HOURS=6
MAX_BACKUPS=30

# ============================================
# CORS / PANEL ADMINA
# ============================================
# URL panelu admina (dla CORS w trybie production)
ADMIN_URL=http://localhost:5173
