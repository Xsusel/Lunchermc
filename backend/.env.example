# ============================================
# KONFIGURACJA SERWERA
# ============================================
PORT=3001
NODE_ENV=production
API_URL=http://localhost:3001

# ============================================
# BEZPIECZEŃSTWO
# ============================================
# Wygeneruj bezpieczny klucz: openssl rand -hex 64
JWT_SECRET=ZMIEN_NA_BEZPIECZNY_KLUCZ_MIN_64_ZNAKOW
JWT_EXPIRES_IN=7d

# Hasło do panelu administracyjnego
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ZMIEN_HASLO_ADMINA

# ============================================
# BAZA DANYCH
# ============================================
DATABASE_PATH=./data/launcher.db

# ============================================
# SERWER MINECRAFT
# ============================================
MC_SERVER_IP=play.twojserwer.pl
MC_SERVER_PORT=25565

# ============================================
# LIMITY
# ============================================
MAX_FILE_SIZE_MB=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
