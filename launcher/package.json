{
  "name": "xsuslauncher",
  "productName": "XsusLauncher",
  "version": "1.0.0",
  "description": "Profesjonalny launcher Minecraft dla serwera Xsus",
  "homepage": "https://mc.xsus.pl",
  "main": "src/main/index.js",
  "author": {
    "name": "Xsus",
    "email": "admin@xsus.pl"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:nobuild": "node scripts/release.js --no-build"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "minecraft-launcher-core": "^3.17.2",
    "msmc": "^4.0.0",
    "extract-zip": "^2.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "pl.xsus.launcher",
    "productName": "XsusLauncher",
    "copyright": "Copyright © 2024 Xsus",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XsusLauncher"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Game",
      "maintainer": "Xsus <admin@xsus.pl>"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.games"
    },
    "publish": {
      "provider": "generic",
      "url": "https://mc.xsus.pl/api/launcher/releases"
    }
  }
}
